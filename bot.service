[Unit]
Description=VPS Admin Telegram Bot
After=network.target

[Service]
Type=simple
User=vpsbot
Group=vpsbot
WorkingDirectory=/path/to/bot
ExecStart=/path/to/bot/venv/bin/python main.py
Restart=always
RestartSec=5
# Security limits
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
