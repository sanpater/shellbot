# Telegram API Credentials
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# Admin ID
ADMIN_ID=123456789

# Database
DB_PATH=data/bot.db

# Limits & Thresholds
MAX_CAPTURE_BYTES=5242880 # 5 MB
MESSAGE_CHUNK_SIZE=3500
COMMAND_TIMEOUT=60
SHELL_IDLE_TIMEOUT=3600
MAX_SHELL_SESSIONS=5
UPLOAD_DIR=data/uploads

# Security & Rate Limiting
LOGIN_MAX_FAILS=3
LOGIN_LOCKOUT_MINUTES=10
COMMAND_RATE_LIMIT=5
COMMAND_RATE_WINDOW=10

# Services
ALLOWED_SERVICES=nginx,systemd-journald
